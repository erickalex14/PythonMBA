{"nodes": [{"id": "contexto_sesion_resumen_mba3_bi_project", "label": "MBA3 BI Project (Novicompu)", "file_type": "concept", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contexto_sesion_resumen_backend_fastapi", "label": "Backend (FastAPI, Backend/app/)", "file_type": "concept", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contexto_sesion_resumen_frontend_nextjs", "label": "Frontend (Next.js 16, frontend/)", "file_type": "concept", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contexto_sesion_resumen_deploy_script", "label": "deploy.py deployment script", "file_type": "concept", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contexto_sesion_resumen_erp_mba3", "label": "ERP MBA3 (PRUEBAS/PRODUCCION)", "file_type": "concept", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contexto_sesion_resumen_github_repo", "label": "GitHub repo erickalex14/PythonMBA", "file_type": "concept", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contexto_sesion_resumen_origin_memo_bug", "label": "ORIGIN_MEMO missing filter bug (ventas_service.py)", "file_type": "rationale", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real-time query to INVT_Producto_Movimientos did not filter ORIGIN_MEMO='CLIENTES' like the historical SQL view did, so warehouse transfers were counted as sales, inflating 'Ventas Hoy' 3x. Fixed by adding the same filter."}, {"id": "contexto_sesion_resumen_nan_infinity_bug", "label": "NaN/Infinity invalid JSON bug (ventas_service.py)", "file_type": "rationale", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Division by zero in real-time computation produced NaN, which Starlette rejected with HTTP 500. Fixed by sanitizing the final DataFrame (.astype(object).where(notna, None)) \u2014 casting to object first is required because Series.where(cond, None) on float64 does not store None directly."}, {"id": "contexto_sesion_resumen_prod_service_bug", "label": "Wrong PROD ERP service (SERIALES vs ERICKDEV)", "file_type": "rationale", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production was pointed at ERP service SERIALES, which lacks INVT_Ficha_Principal, PROV_Liquidaciones_Principal and PROV_Factura_Principal. Switched to service ERICKDEV/REPORTERIA which has them enabled."}, {"id": "contexto_sesion_resumen_middleware_to_proxy_migration", "label": "middleware.ts to proxy.ts migration (Next.js 16)", "file_type": "rationale", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js 16 deprecated middleware.ts, so proxyClientMaxBodySize (100mb->300mb) in next.config.ts was silently never applied. Migrated via the official codemod `npx @next/codemod@canary middleware-to-proxy .`."}, {"id": "contexto_sesion_resumen_nginx_body_size_fix", "label": "nginx client_max_body_size fix", "file_type": "rationale", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "aaPanel's default 50m nginx client_max_body_size blocked large Excel range uploads/downloads; raised to 300m and now deploy.py enforces it on every deploy via regex over the vhost conf."}, {"id": "contexto_sesion_resumen_hardcoded_credentials_fix", "label": "Hardcoded credentials refactor + history purge", "file_type": "rationale", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "14 tracked files had hardcoded credentials; refactored to read from .env/app.config.settings, and git history was purged with git-filter-repo across multiple passes."}, {"id": "contexto_sesion_resumen_scheduler", "label": "APScheduler daily sync (Backend/app/core/scheduler.py)", "file_type": "concept", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "contexto_sesion_resumen_git_dev_branch_issue", "label": "dev branch merge-resurrects-purged-files issue", "file_type": "rationale", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An old local copy of dev still has purged files/secrets as ancestors, so a normal `git pull` merge resurrects them even though main and dev share a common ancestor. Fix: `git fetch origin && git reset --hard origin/main` on that dev's machine; to reconcile selectively, cherry-pick only genuinely new files via `git checkout origin/dev -- <file>` then force-push main onto dev."}, {"id": "contexto_sesion_resumen_pending_tasks", "label": "Pending next steps (this session)", "file_type": "concept", "source_file": "contexto-sesion/resumen.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "contexto_sesion_resumen_mba3_bi_project", "target": 